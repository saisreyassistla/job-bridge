{
  "name": "jobbridge",
  "version": "0.2.0",
  "description": "A Slack agent that helps job seekers find jobs, understand companies, and prepare to apply \u2014 powered by Hybrid RAG + MCP + Apify.",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "server": "node server/index.js",
    "dev": "node --watch app.js",
    "rag": "cd rag && uvicorn api.server:app --reload --port 8000",
    "rag:ingest": "cd rag && python scripts/ingest_docs.py",
    "test": "node --test tests/conversation-context.test.js",
    "test:rag": "cd rag && python tests/test_rrf.py && python tests/test_chunker.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@slack/bolt": "^4.7.0",
    "apify-client": "^2.11.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  }
}
